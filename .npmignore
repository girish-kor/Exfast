tests/
.github/
.gitignore
.eslintrc
eslint.config.js
.env.example
example.js
CONTRIBUTING.md
CODE_OF_CONDUCT.md
PROJECT_STRUCTURE.md

# Documentation (optional, include in some cases)
# README.md
# LICENSE

